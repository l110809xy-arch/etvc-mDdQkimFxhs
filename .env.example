# ============================================
# AI 智能客服（Google Gemini）配置
# ============================================
# 1. 打开 https://aistudio.google.com/apikey 创建 API Key
# 2. 把 Key 填到下面的 GEMINI_API_KEY（不要提交到 git，.env* 已忽略）
# 3. 改完需要重启 npm run dev / 重新部署
#
# 未配置时站点照常运行，只有聊天接口返回 503，右下角客服按钮仍会显示。

GEMINI_API_KEY=

# 可选：切换模型。默认 gemini-2.5-flash（便宜、快、够用）
# 其他可用值：gemini-2.5-flash-lite、gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# 站点地址（SEO 用）
# ============================================
# 影响 canonical、hreflang、sitemap.xml、robots.txt、Open Graph 与 JSON-LD 里的绝对地址。
# 未配置时回退到 https://etvc-website.vercel.app。
# 绑定自定义域名后，在 Vercel 环境变量里改成正式域名即可，不需要改代码。
NEXT_PUBLIC_SITE_URL=

# ============================================
# 数据库（Supabase）
# ============================================
# 1. 打开 https://supabase.com/dashboard 新建项目（免费）
# 2. 项目 → Settings → API，抄下 Project URL、anon key、service_role key
# 3. 项目 → SQL Editor，粘贴 supabase/schema.sql 全文执行一次
#
# ⚠️ service_role key 能绕过所有权限，只能放服务端，绝不能加 NEXT_PUBLIC_ 前缀。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 后台管理员登录账号（首次部署时用来创建管理员，创建后可留空）
ADMIN_EMAIL=
ADMIN_PASSWORD=

